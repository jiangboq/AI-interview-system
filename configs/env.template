# ── MongoDB ──────────────────────────────────────────────────────────────────
# Connection string for MongoDB (used for transcripts/logs storage)
MONGO_URL=mongodb://localhost:27017

# ── Postgres ────────────────────────────────────────────────────────────────
# Postgres username for the app database
POSTGRES_USER=admin
# Postgres password for the app database
POSTGRES_PASSWORD=admin
# Postgres database name
POSTGRES_DB=interview
# Postgres host to connect to when running the API outside Docker; defaults to localhost
POSTGRES_HOST=
# Postgres port to connect to when running the API outside Docker; defaults to 5432
POSTGRES_PORT=
# Full DSN override; if set, takes precedence over the POSTGRES_* fields above
DATABASE_URL=
# Minimum number of connections kept open in the DB connection pool
DB_POOL_MIN_SIZE=1
# Maximum number of connections allowed in the DB connection pool
DB_POOL_MAX_SIZE=10

# ── AI / LLM ────────────────────────────────────────────────────────────────
# OpenAI API key used for resume parsing, JD parsing, embeddings, and interview scoring
OPENAI_API_KEY=

# ── LiveKit ──────────────────────────────────────────────────────────────────
# WebSocket URL of the LiveKit server (e.g. ws://localhost:7880)
LIVEKIT_URL=
# LiveKit API key used to generate room access tokens
LIVEKIT_API_KEY=
# LiveKit API secret used to sign room access tokens
LIVEKIT_API_SECRET=

# ── Auth / Security ──────────────────────────────────────────────────────────
# Secret used to sign/verify JWT auth tokens; must be overridden in production
SECRET_KEY=dev-secret-key-change-in-production
# Minutes an admin/HR login session stays valid without activity before requiring re-login
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Minutes a candidate's interview session token stays valid after confirming email/access code
CANDIDATE_SESSION_MINUTES=120

# ── Frontend ─────────────────────────────────────────────────────────────────
# Base API URL exposed to the browser (Next.js client-side requests)
NEXT_PUBLIC_API_URL=

# ── App ──────────────────────────────────────────────────────────────────────
# Base URL the voice agent uses to call back into the API server
API_URL=http://localhost:8000
# Logging verbosity (e.g. DEBUG, INFO, WARNING, ERROR); defaults to INFO
LOG_LEVEL=
# Deployment environment. Set to "production" to require DATABASE_URL to be
# explicitly set (the app refuses to fall back to dev database credentials).
ENVIRONMENT=

